        <mxCell id="53" connectable="0" parent="42" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="MuSig2 adaptor signature&lt;br&gt;reveals p&lt;sub&gt;a&lt;/sub&gt; only to Bob" vertex="1">
